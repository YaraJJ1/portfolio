{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "test.html",
      "testScript.js",
      "testStyle.css"
    ],
    "headers": [
      {
        "regex": "^(/|/[^.]*|.*\\.(html|js|css|json|svg))$",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
